<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>SVG Map with Layers</title>
<style>
  /* Style for toggle buttons */
  .layer-toggle {
    margin: 5px;
    padding: 8px 12px;
    cursor: pointer;
    background-color: #007bff;
    color: white;
    border: none;
    border-radius: 4px;
  }

  /* Optional: hover effect for buttons */
  .layer-toggle:hover {
    background-color: #0056b3;
  }
</style>
</head>
<body>

<h2>Map Layers Control</h2>
<!-- Buttons to toggle layers -->
<button class="layer-toggle" onclick="toggleLayer('features-landmarks')">Features & Landmarks</button>
<button class="layer-toggle" onclick="toggleLayer('zones')">Zones</button>
<button class="layer-toggle" onclick="toggleLayer('schools')">Schools</button>

<!-- Your SVG Map -->
<svg id="map" width="800" height="600" viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg">
  <!-- Replace this comment with your actual SVG content -->
  <!-- Example structure: -->
  <!--
  <g id="features-landmarks">
    <circle cx="100" cy="100" r="20" fill="#a3c9a8" />
    <text x="100" y="105" font-size="12" text-anchor="middle" fill="#000">Landmark 1</text>
  </g>
  <g id="zones">
   
  </g>
  <g id="schools">
    <rect x="400" y="300" width="50" height="30" fill="#e76f51"/>
    <text x="425" y="320" font-size="12" text-anchor="middle" fill="#000">School 1</text>
  </g>
  -->
  <!-- Your actual SVG elements go here -->
</svg>

<script>
// Function to toggle layer visibility
function toggleLayer(layerId) {
  const layer = document.getElementById(layerId);
  if (layer) {
    if (layer.style.display === 'none') {
      layer.style.display = 'block';
    } else {
      layer.style.display = 'none';
    }
  }
}
</script>

</body>
</html>
